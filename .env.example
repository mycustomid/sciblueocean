# Local demo only; binds 127.0.0.1 and uses temporary SQLite file.
BLUE_OCEAN_DEMO_PASSWORD=change-this-local-demo-only
BLUE_OCEAN_HTTP_LOG=0
BLUE_OCEAN_ENABLE_SIMULATED_SETTLEMENT=NO

# Merchant account must be opened and KYC-approved by SCI Blue Ocean owner.
# OPTIONAL Flutterwave TEST sandbox bridge; NEVER use live keys in loopback demo.
BLUE_OCEAN_ENABLE_FLW_TEST_CHECKOUT=NO
FLW_SECRET_KEY=FLWSECK_TEST-REPLACE_WITH_CLIENT_TEST_KEY
FLW_SECRET_HASH=REPLACE_WITH_STRONG_RANDOM_WEBHOOK_HASH
FLW_CALLBACK_URL=https://your-staging-domain.example/api/demo/flutterwave/callback
