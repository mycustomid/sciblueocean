# Use a non-production PostgreSQL database. Never commit real credentials.
DATABASE_URL=postgres://erp_user:change_this@127.0.0.1:5432/blue_line_erp
ERP_LISTEN_ADDR=127.0.0.1:8085
# Local development only; browser must access API from an explicitly allowed origin.
ERP_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
RUST_LOG=info
# Bootstrap CLI only; set locally before running; don't store real password in file.
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_COMPANY_NAME=

# RC8 demo GL account mapping CLI (NEVER use for regulated postings):
# PROVISION_ENTITY_ID=<uuid>
# TRADE_DEMO_ACK=I_UNDERSTAND_DEMO_ONLY

# RC11 schema gate. NEVER enable auto-migration in staging/production.
ERP_ENV=development
ERP_AUTO_MIGRATE=false
