RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Proxy /api requests to VPS Operations Backend
<IfModule mod_proxy.c>
  SSLProxyEngine on
  RewriteRule ^api/staff/(.*)$ https://sciblueocean-api.163.61.44.41.sslip.io/api/staff/$1 [P,L]
  RewriteRule ^api/booking/(.*)$ https://sciblueocean-api.163.61.44.41.sslip.io/api/booking/$1 [P,L]
</IfModule>

# If mod_proxy is not enabled, forward to PHP proxy fallback
<IfModule !mod_proxy.c>
  RewriteRule ^api/(.*)$ /api_proxy.php?path=$1 [QSA,L]
</IfModule>

# Clean URL directory index handling
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
