---
// SCI BLUE OCEAN — static Astro shell; interactions ship as progressive, framework-free JavaScript.
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#102a38" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="SCI Blue Ocean Hotel OS — démonstration interactive de gestion hôtelière. Données entièrement fictives." />
  <title>SCI Blue Ocean — Hotel OS · Démonstration</title>
  <link rel="icon" type="image/png" href="/brand/logo-icon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/styles.css" />
  <script src="/app.js" defer></script>
</head>
<body>
  <div class="app-shell" id="appShell">
    <aside class="sidebar" id="sidebar" aria-label="Navigation principale">
      <a class="brand" href="#overview" aria-label="SCI Blue Ocean Hotel OS — Accueil">
        <span class="brand-symbol" aria-hidden="true"><img src="/brand/logo-main.png" alt="" class="brand-logo" width="112" height="57" /></span>
        <span class="brand-copy"><strong>SCI BLUE OCEAN</strong><small>HOSPITALITY OPERATIONS</small></span>
      </a>
      <div class="workspace-label"><span class="presence-dot"></span> <span data-i18n="workspace">Espace de travail</span><span class="edition">DEMO</span></div>
      <nav id="mainNav" class="nav-stack" aria-label="Sections"></nav>
      <div class="sidebar-bottom">
        <div class="demo-note"><span class="demo-note-icon" aria-hidden="true">✳</span><strong data-i18n="sandbox">Environnement de démonstration</strong><p data-i18n="sandboxDesc">Données fictives · aucune transaction réelle</p></div>
        <div class="sidebar-footer"><span>BLUE OCEAN / OS</span><span>v1.0</span></div>
      </div>
    </aside>
    <div class="scrim" id="scrim" hidden></div>
    <div class="app-content">
      <header class="topbar">
        <div class="topbar-left">
          <button class="icon-button menu-button" type="button" id="menuToggle" aria-label="Ouvrir le menu" aria-expanded="false"><span class="menu-lines">☰</span></button>
          <div class="topbar-context"><span class="breadcrumb">SCI Blue Ocean</span><span class="breadcrumb-chevron">/</span><strong id="crumbTitle">Vue d'ensemble</strong></div>
          <span class="top-demo"><span class="presence-dot"></span> DEMO MODE</span>
        </div>
        <div class="topbar-actions">
          <span class="top-date" id="todayPill"></span>
          <div class="lang-switch" role="group" aria-label="Langue / Language"><button data-lang="fr" aria-pressed="true" type="button">FR</button><button data-lang="en" aria-pressed="false" type="button">EN</button></div>
          <label class="role-label" for="roleSelect"><span data-i18n="role">Rôle</span><select id="roleSelect" aria-label="Sélectionner un rôle de démonstration"><option value="direction">Direction générale</option><option value="reception">Réception</option><option value="housekeeping">Gouvernante</option><option value="finance">Comptabilité</option></select></label>
          <div class="user-avatar" aria-hidden="true">BO</div>
        </div>
      </header>
      <main class="main-content" id="mainContent" tabindex="-1">
        <div class="page-heading"><div><div class="eyebrow" id="pageEyebrow">HOSPITALITY INTELLIGENCE / 01</div><h1 id="pageTitle">Vue d'ensemble<span class="heading-dot">.</span></h1><p id="pageDescription">L'essentiel de vos opérations, en un seul regard.</p></div><div class="heading-actions" id="headingActions"></div></div>
        <div id="mainView" aria-live="polite"></div>
      </main>
      <footer class="app-footer"><span>© 2026 SCI BLUE OCEAN · HOTEL OS <b>DEMO</b></span><span data-i18n="footer">Prototype opérationnel · aucune donnée réelle</span></footer>
    </div>
  </div>
  <div class="modal-root" id="modalRoot" hidden></div>
  <div id="toastRoot" class="toast-root" role="status" aria-live="polite"></div>
  <div id="printRoot" class="print-root" aria-hidden="true"></div>
</body>
</html>
